# Supabase 프로젝트 주소와 서버용 secret 키 (브라우저에 노출하면 안 됨)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_xxx

# 채점 큐로 쓰는 Redis
REDIS_URL=redis://redis:6379/0

# 브라우저가 이 API를 직접 부를 때 허용할 출처 (쉼표로 구분). 지정하면 이 목록만 허용한다.
# 비워 두면 개발용 http://localhost:3000만 허용한다. 프론트가 같은 도메인의 /api로 부르면 필요 없다.
ALLOWED_ORIGINS=

# 채점을 요청할 수 있는 이메일 도메인 (쉼표로 구분). 비워 두면 제한하지 않는다.
ALLOWED_EMAIL_DOMAINS=bssm.hs.kr

# 개발할 때만 1로 두면 코드가 바뀔 때마다 서버가 다시 뜬다. 운영에서는 비워 둔다.
UVICORN_RELOAD=

# solved.ac 연동. https://backstage.solved.ac/developer/apps 에 앱을 등록하고 받은 값을 넣는다.
# 셋 중 하나라도 비우면 solved.ac 연동만 꺼지고 나머지 기능은 그대로 동작한다.
# secret은 서버에서만 쓴다. 프론트엔드(.env)에 넣지 않는다.
SOLVEDAC_CLIENT_ID=
SOLVEDAC_CLIENT_SECRET=
# 연동을 마친 사용자가 돌아올 주소. 콘솔에 등록한 주소와 한 글자도 달라서는 안 된다.
# 프론트가 /api를 이 API로 넘기므로 운영에서는 https://<사이트 주소>/api/integrations/solvedac/callback
SOLVEDAC_REDIRECT_URI=
