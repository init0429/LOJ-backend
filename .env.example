# Supabase 프로젝트 주소와 서버용 secret 키 (브라우저에 노출하면 안 됨)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_xxx

# 채점 큐로 쓰는 Redis
REDIS_URL=redis://redis:6379/0

# 브라우저가 이 API를 직접 부를 때 허용할 출처 (쉼표로 구분). 지정하면 이 목록만 허용한다.
# 비워 두면 개발용 http://localhost:3000만 허용한다. 프론트가 같은 도메인의 /api로 부르면 필요 없다.
ALLOWED_ORIGINS=

# 채점을 요청할 수 있는 이메일 도메인 (쉼표로 구분). 비워 두면 제한하지 않는다.
ALLOWED_EMAIL_DOMAINS=bssm.hs.kr

# 개발할 때만 1로 두면 코드가 바뀔 때마다 서버가 다시 뜬다. 운영에서는 비워 둔다.
UVICORN_RELOAD=
