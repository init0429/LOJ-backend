# Supabase 프로젝트 주소와 서버용 secret 키 (브라우저에 노출하면 안 됨)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_xxx

# 채점 큐로 쓰는 Redis
REDIS_URL=redis://redis:6379/0

# 브라우저가 이 API를 직접 부를 때 허용할 출처 (쉼표로 구분).
# localhost:3000은 항상 허용된다. 프론트가 자기 서버를 거쳐 호출하면 비워 둬도 된다.
ALLOWED_ORIGINS=https://example.com

# 채점을 요청할 수 있는 이메일 도메인 (쉼표로 구분). 비워 두면 제한하지 않는다.
ALLOWED_EMAIL_DOMAINS=bssm.hs.kr
